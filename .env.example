# =============================================================================
# 乌叶MC · 模组许愿池 — 环境变量示例
# =============================================================================
# 用法一（本地开发，Node 22.5+）：
#   cp .env.example .env
#   node --env-file=.env server.js
#   注意：项目没有 dotenv 依赖，`npm start` / `node server.js`
#   都【不会】自动读取 .env，必须显式加 --env-file（或先 export 环境变量）。
#
# 用法二（生产，systemd）：
#   不要直接使用本文件的默认值；按文末「生产示例」改成 HTTPS + 反代配置，
#   复制成 /etc/wuye-mod-hub/wuye.env（root:root 600），
#   unit 里用 EnvironmentFile=/etc/wuye-mod-hub/wuye.env 读取。
#
# 用法三（临时覆盖）：
#   Windows PowerShell:  $env:PORT=8090; npm start
#   Linux / macOS:       PORT=8090 npm start
#
# 本文件只放示例值，不要写任何真实管理码或密码。
# =============================================================================

# ---------------------------------------------------------------------------
# 网络监听
# ---------------------------------------------------------------------------

# 监听端口。默认 8080。
# 生产环境放在 Nginx 后面时保持 8080，由 Nginx 的 443 对外提供服务。
PORT=8080

# 监听地址。默认 0.0.0.0（所有网卡），本地开发用 http://127.0.0.1:8080 访问。
# 生产环境必须改成 127.0.0.1，只允许本机 Nginx 反代，避免 Node 裸奔公网。
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# 数据
# ---------------------------------------------------------------------------

# SQLite 数据目录。不设置时默认 <项目根>/data，目录不存在会自动创建。
# 数据库文件为 wuye.db，使用 WAL 模式，运行时还会出现 wuye.db-wal / wuye.db-shm。
# 相对路径相对于进程工作目录（systemd 的 WorkingDirectory）；生产建议写绝对路径。
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# 管理码（只影响首次初始化）
# ---------------------------------------------------------------------------

# 首次启动时用它初始化站长管理码，长度必须 >= 10（建议 16 位以上随机串）。
# 只有数据库里还没有管理码时才生效；之后要改码请登录 /admin →「站点设置」，
# 改码会吊销所有已登录会话，并提示重新登录。
# 不设置这个变量时，程序会自动生成 WY-XXXX-XXXX-XXXX 形式的码，
# 同时写到 <DATA_DIR>/admin-code.txt 并打印到启动日志（stdout / journald）。
# ADMIN_CODE=请改成你自己的强管理码

# ---------------------------------------------------------------------------
# 反向代理 / Cookie（本地默认关闭，生产必须打开）
# ---------------------------------------------------------------------------

# 置 1 时信任 X-Forwarded-For / X-Forwarded-Proto 等反代头。
# 放在 Nginx / 云负载均衡后面【必须】设为 1，否则所有访客都会被识别为 127.0.0.1，
# 限流会互相误伤，后台审计日志里的 IP 哈希也会失去区分度。
TRUST_PROXY=0

# 置 1 时登录 / 访客 Cookie 带 Secure 属性，只通过 HTTPS 发送。
# 生产（已配置 HTTPS）必须为 1；纯 HTTP 本地调试保持 0，否则后台登录后
# 浏览器不会保存 Cookie，会表现成「登录成功但马上又未登录」。
COOKIE_SECURE=0

# 运行模式。当前版本没有基于 NODE_ENV 的行为分支（API 错误始终只返回中文提示，
# 详细堆栈只写服务端日志）；保留它是为了与部署约定、监控和后续版本保持一致。
# NODE_ENV=development

# ---------------------------------------------------------------------------
# 备份脚本（scripts/backup.js 专用，Web 服务不读取）
# ---------------------------------------------------------------------------

# 备份输出目录。不设置时默认 <项目根>/backups。相对路径由备份脚本解析为
# 「项目根下的相对路径」，与执行时的当前目录无关，方便放进 cron / systemd。
# 每次备份会生成一个 snapshot-YYYYMMDD-HHmmss/ 目录：
#   wuye.db（VACUUM 在线快照）+ files/（模组上传）+ media/（图片）
#   + secrets/（管理码、中继密钥、CF token，存在才备份）
#   + manifest.json（行数/大小/哈希）+ SHA256SUMS
# BACKUP_DIR=./backups

# 保留最近多少份快照，默认 14（上限 3650）；必须是 >= 1 的整数。
# KEEP=14

# 加密异地备份目录（可选）。只设置 BACKUP_DIR 时，备份只留在同一台服务器上，
# 那不算异地备份。scripts/offsite-sync.sh 会先让 backup.js 把快照加密写入
# OFFSITE_DIR，再用 rclone 同步到 RCLONE_DEST（真正的异地对象存储）。
# push 的顺序是「上传 → 校验远端齐全 → 才清理本地过期 snapshot-* → 再同步远端删除」。
# 上传或校验失败时不会清理本地旧快照。若 OFFSITE_DIR/RCLONE_DEST/BACKUP_PASSPHRASE
# 只配了一半，push 会直接报错退出（不会静默假装异地备份成功）。
# OFFSITE_DIR=/opt/wuye/offsite

# 异地备份的加密口令（只有设置了 OFFSITE_DIR 才需要）。
# 脚本用 AES-256-GCM + scrypt 加密每个文件，口令不会写进备份目录；
# 丢失口令 = 异地备份无法恢复，请存进密码管理器，并另存一份离线副本。
# 生产环境建议写在 /etc/wuye/backup.env（root:wuye 640），由 systemd EnvironmentFile 读取。
# BACKUP_PASSPHRASE=请改成你自己的长口令

# rclone 远端路径（必填才能启用异地同步）。已批准的方案：Backblaze B2 EU Central，
# 私有桶 wuye-prod-backups-2026，凭据用桶级受限 Application Key：
#   RCLONE_DEST=b2:wuye-prod-backups-2026/snapshots
# RCLONE_DEST=

# rclone 配置文件路径。生产用 systemd 运行时 HOME 被限制，必须显式指定，
# 否则 rclone 找不到 ~/.config/rclone/rclone.conf。
# 创建顺序（否则 wuye 写不进去）：先 sudo install -d -m 0770 -o root -g wuye /etc/wuye，
# 再 sudo -u wuye sh -c 'umask 077; rclone config --config /etc/wuye/rclone.conf'，
# 之后 sudo chown root:wuye /etc/wuye/rclone.conf && sudo chmod 0640（目录再改回 0750）。
# RCLONE_CONFIG=/etc/wuye/rclone.conf

# 远端与本地加密快照的保留天数，脚本默认 90；生产批准值为 30 天
# （本地快照另按 KEEP=14 份轮换；B2 生命周期规则见 deploy/BACKUP.md 5.4）。
# OFFSITE_KEEP_DAYS=30

# =============================================================================
# 生产环境示例（systemd 的 /etc/wuye/wuye.env 用这一组值）
# =============================================================================
# PORT=8080
# HOST=127.0.0.1
# DATA_DIR=/opt/wuye/data
# TRUST_PROXY=1
# COOKIE_SECURE=1
# NODE_ENV=production
#
# 备份 unit 用的是 deploy/wuye-backup.service 里写死的这一组（不用 wuye.env）：
#   DATA_DIR=/opt/wuye/data
#   BACKUP_DIR=/opt/wuye/backups
#   KEEP=14
#   OFFSITE_DIR=/opt/wuye/offsite
# 加密异地备份的 BACKUP_PASSPHRASE / RCLONE_DEST / RCLONE_CONFIG 放在 /etc/wuye/backup.env。
# 已批准的方案：Backblaze B2 EU Central（Amsterdam，私有桶 wuye-prod-backups-2026）+ rclone 同步，
# 凭据用桶级受限 Application Key，快照在客户端 AES-256-GCM 加密，保留 30 天。
# 注意：在真正创建 B2 存储桶并完成一次「上传 → 下载 → 解密 → SHA-256 → 恢复」验证前，
# 异地备份视为【未配置】，本地备份不能作为唯一副本。
#
# 站点域名示例：https://wuye.example.com（见 deploy/nginx.conf）
