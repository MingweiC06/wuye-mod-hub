[Unit]
# 乌叶MC — daily encrypted backup: snapshot -> encrypt (v2) -> upload to B2 -> check -> prune
Description=Wuye data backup + encrypted offsite to B2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wuye
Group=wuye
WorkingDirectory=/opt/wuye-backup
Environment=NODE_ENV=production
Environment=HOME=/tmp
EnvironmentFile=/etc/wuye/backup.env
ExecStart=/bin/sh /opt/wuye-backup/scripts/offsite-sync.sh push
# Only runs if the push succeeded. The admin overview warns when this is older than 36 h.
ExecStartPost=/bin/sh -c 'date +%%s > /opt/wuye/backups/.last-offsite-ok'
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
SyslogIdentifier=wuye-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadOnlyPaths=/opt/wuye/data
ReadWritePaths=/opt/wuye/backups /opt/wuye/offsite-v2
StandardOutput=journal
StandardError=journal
